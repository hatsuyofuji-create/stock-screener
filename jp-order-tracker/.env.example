# このファイルを .env にコピーして値を入れてください（.env は .gitignore 済み）

# 受注高の抽出に必須（Anthropic APIキー）
ANTHROPIC_API_KEY=

# 抽出に使うモデル（未指定なら claude-opus-5）。
# コスト優先なら claude-sonnet-5 / claude-haiku-4-5 に変更可。
# ANTHROPIC_MODEL=claude-sonnet-5

# 開示日の特定に使う（--announcements のときだけ必要）。受注高そのものは入っていない。
JQUANTS_API_KEY=
# JQUANTS_BASE=https://api.jquants.com/v2
