# ====== jp-spike-analyzer 環境変数サンプル ======
# このファイルを .env にコピーして、値を記入してください。
# .env は .gitignore 済みなのでコミットされません。

# データ提供元: mock（鍵不要・動作確認用） または jquants（本番）
# mock のときは適時開示・EDINET・ニュースも全部ダミーになります。
PROVIDER=mock

# ---- J-Quants（PROVIDER=jquants のとき必要・V2 APIキー方式） ----
# ダッシュボードで発行した APIキー。x-api-key ヘッダで送ります。
JQUANTS_API_KEY=
JQUANTS_BASE=https://api.jquants.com/v2

# ---- EDINET API（金融庁・無料）。未設定なら EDINET 照合をスキップします ----
# 発行: https://api.edinet-fsa.go.jp/api/auth/index.aspx?mode=1
EDINET_API_KEY=

# ---- 適時開示の過去分バックフィル（非公式 TDnet WebAPI）。通常は変更不要 ----
TDNET_BACKFILL_BASE=https://webapi.yanoshin.jp/webapi/tdnet/list

# ---- 急騰の定義（省略時は config.py の初期値） ----
# 前日終値→翌営業日終値が SPIKE_PCT % 以上なら急騰
SPIKE_PCT=8
# 遡る年数（Light は最大5）
SPIKE_YEARS=5
