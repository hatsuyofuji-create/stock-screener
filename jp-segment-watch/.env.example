# jp-segment-watch 設定例。これを .env にコピーして値を入れる（.env は .gitignore 済み）。

# 提供元: mock（鍵不要）/ edinet（本番）。未指定なら EDINET_API_KEY の有無で自動判定。
PROVIDER=edinet

# EDINET API v2 の購読キー（金融庁 EDINET の「アカウント管理」で無料発行）
EDINET_API_KEY=

# 直近何日ぶんの提出書類を見るか（既定 3）
SEGMENT_WINDOW_DAYS=3

# 初期の履歴づくり用。指定するとその日から今日までを走査（例: 過去13か月）
# SEGMENT_SINCE=2025-06-01

# LINE 通知（任意・未設定ならコンソール出力にフォールバック）
LINE_CHANNEL_ACCESS_TOKEN=
LINE_USER_ID=
