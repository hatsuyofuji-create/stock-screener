# value-app バックエンドの環境変数（.env にコピーして使用。.env は .gitignore 済み）

# DB 接続（未設定なら backend/value_app.db の SQLite）
# DATABASE_URL=sqlite:///./value_app.db

# データ取得プロバイダ: mock（鍵不要）/ jquants
PROVIDER=mock

# J-Quants API V2（PROVIDER=jquants のとき必須。APIキー方式）
# JQUANTS_API_KEY=
# JQUANTS_BASE=https://api.jquants.com/v2
